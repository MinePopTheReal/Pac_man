# Pac-Man configuration file.
# Lines starting with '#' are comments. Comments with '//' and '/* */'
# are also supported. Missing or invalid values are replaced by their
# default value, with a warning. Unknown keys are ignored.
{
    # File where the top 10 high_score are saved (default: "high_score.json")
    "high_score_filename": "high_score/high_score.json",

    # Number of lives at the start of the game (min 1, default: 3)
    "lives": 3,

    # Number of pacgums placed in each maze, super-pacgums not included
    # (min 0, default: 202). Capped to the number of free cells.
    "pacgum": 202,

    # Points earned for each pacgum eaten (min 0, default: 10)
    "points_pacgum": 10,

    # Points earned for each super-pacgum eaten (min 0, default: 50)
    "points_super_pacgum": 50,

    # Points earned for each ghost eaten (min 0, default: 200)
    "points_ghost": 200,

    # Seed of the first level's maze, the next levels are random.
    # 0 makes the first level random too (min 0, default: 42)
    "seed": 42,

    # Time limit of each level, in seconds (min 1, default: 90)
    "level_max_time": 120,

    # Width of the maze, in cells (min 14, max 50, default: 15)
    "width": 15,

    # Height of the maze, in cells (min 10, max 50, default: 15)
    "height": 15,

    # Number of levels to complete to win the game (min 10, max 99, default: 10)
    "nb_level": 10,

    # Time during which ghosts can be eaten, in seconds (min 1, default: 10.0)
    "timer_hunt_ghosts": 10.0,

    # Time an eaten ghost waits in its corner, in seconds (min 1, default: 5.0)
    "timer_respawn_ghost": 5.0
}